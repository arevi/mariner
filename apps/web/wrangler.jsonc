{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marginer-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    {
      "binding": "VESSELS",
      "bucket_name": "mariner-vessels",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mariner",
      "database_id": "db560970-eb81-4bd7-b1b2-84626bc11e90",
    },
  ],
  "ratelimits": [
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
