{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariner-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "r2_buckets": [
    {
      "binding": "VESSELS",
      "bucket_name": "mariner-vessels",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mariner",
      "database_id": "db560970-eb81-4bd7-b1b2-84626bc11e90",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "LISTEN_SECONDS": "600",
  },
  "upload_source_maps": true,
}
